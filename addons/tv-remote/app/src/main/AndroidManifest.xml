<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The WebSocket to your relay, and Sony IP control on the TV itself (127.0.0.1 / the TV's own address). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- RemoteService holds the relay connection; LiveService holds the screen capture for the live view. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Connect again after a reboot, and put the lock screen back if the TV was locked. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The lock timer's countdown pill, and starting the message, lock and capture screens from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Never asked for: granted over adb (appops GET_USAGE_STATS) by install.sh, for Screen time. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Never asked for: granted over adb (pm grant) by install.sh, for ADB on/off from the phone. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: the phone's app list and launch, and app names in Screen time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TvRemote">

        <!-- The card: the pairing QR code, the relay status and New code. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- A message from the phone, over whatever is playing. -->
        <activity
            android:name=".BannerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.ptrinh.tvremote.banner"
            android:theme="@style/Theme.TvRemote.Overlay" />

        <!-- "This TV is locked" with the PIN pad; comes back to the front while the TV is locked. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.ptrinh.tvremote.lock" />

        <!-- Live view: LiveCapture asks for screen capture (answered without a dialog after
             `appops set io.github.ptrinh.tvremote PROJECT_MEDIA allow`), LiveService holds it. -->
        <activity
            android:name=".LiveCapture"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".LiveService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to the owner's own phone-remote relay open, so the TV answers the paired phone" />
        </service>

        <!-- Keyboard from the phone (types into the focused text field), Back/Home and standby without IP control. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="@string/key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- install.sh sets the relay's address with am broadcast; only holders of DUMP (ADB's shell) can. -->
        <receiver
            android:name=".RelayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
